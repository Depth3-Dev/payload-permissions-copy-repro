@@ -1,4 +1,11 @@
-import { deepCopyObject } from './deepCopyObject.js';
+// Repro patch. `sanitizePermissions` sanitizes in place, as Payload's main (4.0) does since 45e833fe: the
+// same fix as 21bdbbf3 on 3.x, without its whole deep copy. Each occurrence of a reused block already has
+// its own permissions object (21bdbbf3: no cache across entities, a copy per occurrence). Results returned
+// by access functions are stored as copies, so sanitizing in place never edits an object the application
+// handed over. The copies are made where those results enter the tree: getEntityPermissions' `where` and
+// getAccessResults' `canAccessAdmin`. The whole copy costs milliseconds a call on a large config, and an
+// admin page calls getAccessResults three times.
+// Remove this patch when Payload drops the copy.
 // A period cannot occur in a schema field name. Retain this false value through
 // sanitization, then remove it after cleanup so a repeated block keeps `fields: {}`.
 const recursiveBlockBoundaryKey = '\u0000payload.recursive-block-boundary';
@@ -187,9 +194,7 @@ export function recursivelySanitizeGlobals(obj) {
  * Recursively remove empty objects and false values from an object.
  *
  * @internal
- */ export function sanitizePermissions(permissions) {
-    // Each occurrence must be sanitized independently, including shared block references.
-    const data = deepCopyObject(permissions);
+ */ export function sanitizePermissions(data) {
     if (data.canAccessAdmin === false) {
         delete data.canAccessAdmin;
     }
